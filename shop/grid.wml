<?xml version="1.0"?>
<wml>
  <card id="P" device="wapform.html">
    <setvar name="gp" value="'0000'"/>
    <setvar name="gp" value="request.gp" cnd="define(request.gp)"/>
    <setvar name="pg" value="1"/>
    <setvar name="pg" value="val(request.pg)" cnd="define(request.pg)"/>
    <setvar name="az" value="'zz'"/>
    <setvar name="az" value="request.sort" cnd="define(request.sort)"/>
    <setvar name="i" value="0"/>
    <setvar name="s" value="'Product Info'"/>
    <setvar name="b" value="0"/>
    <setvar name="gtitle" value="mid(gp,1,2)+'00'"/>
    <if cnd="DEFINE(session.usr)">
      <setvar name="B" value="1" cnd="session.usr='admin'"/>
    </if>
    <dbquery id="sys">
      select * from sys
    </dbquery>
    <dbquery id="grp">
      <![CDATA[select pno, gid, des from pa where pno='$gp' and active>0 order by pno]]>
    </dbquery>
    <setvar name="s" value="grp.des"/>
    <setvar name="s" value="grp.gid"/>

    <if cnd="gp='0000'">
      <setvar name="category" value="'All Categories'"/>
      <else/>
      <setvar name="category" value="grp.des"/>
    </if>

    <block name="wapform.aa"/>
    <include name="header"/>
    <block name="ongrid"/>
    <include name="footer"/>
    <include name="asider"/>
    <block name="wapform.zz"/>
  </card>

  <card id="slider" device="sub">
    <block name="slider"/>
  </card>

  <card id="breadcrumb" device="sub">
    <if cnd="gp='0000'">
      <block name="breadcrumb1" one="'All Categories'"/>
    <else/>
      <block name="breadcrumb1" one="grp.des"/>
    </if>
  </card>

  <card id="sidebar" device="sub">
    <setvar name="i" value="0" />
    <setvar name="j" value="0" />
    <setvar name="k" value="0" />
    <setvar name="p" value="0" />
    <setvar name="x" value="0" />
    <setvar name="y" value="0" />
    <block name="bookbar.aa" />
    <while cnd="not(mnu_count[k]=999999)">
      <if cnd="1">
        <setvar name="x" value="mnu_count[k]" />
        <setvar name="ic" value="'fa fa-th'" />
        <setvar name="ic" value="mnu_icon[k]" cnd="len(mnu_icon[k])&gt;0" />
        <setvar name="app" value="'grid'" />
        <setvar name="column_count" value="ceil(x/10)" />
        <switch exp="mnu_typ[k]">
          <case value="b">
            <setvar name="ic" value="ic+' text-danger'" />
            <setvar name="app" value="'book'" />
          </case>
          <case value="n">
            <setvar name="ic" value="ic+' text-info'" />
            <setvar name="app" value="'grid'" />
          </case>
          <case value="p">
            <setvar name="ic" value="ic+' text-blue'" />
            <setvar name="app" value="'grid'" />
          </case>
          <default>
            <setvar name="ic" value="ic+' text-success'" />
            <setvar name="app" value="'grid'" />
          </default>
        </switch>
      </if>
      <block name="bookbar-list.aa" />
      <setvar name="i" value="0" />
      <setvar name="k" value="k+1" />
      <while cnd="i&lt;x">
        <if cnd="1">
          <setvar name="ic" value="''" />
          <setvar name="app" value="''" />
          <switch exp="mnu_typ[k]">
            <case value="b">
              <setvar name="app" value="'book'" />
            </case>
            <case value="n">
              <setvar name="app" value="'note'" />
            </case>
            <case value="p">
              <setvar name="app" value="'page'" />
            </case>
            <case value="s">
              <setvar name="app" value="'shop'" />
            </case>
            <default>
              <setvar name="app" value="'grid'" />
            </default>
          </switch>
        </if>
        <block name="bookbar-item" cnd="mnu_id[k]&lt;&gt;gp"/>
        <block name="bookbar-active" cnd="mnu_id[k]=gp"/>
        <setvar name="i" value="i+1" />
        <setvar name="k" value="k+1" />
      </while>
      <block name="bookbar-list.zz" />
      <setvar name="j" value="j+1" />
    </while>
    <block name="bookbar.zz" />
    <exit/>
    <!-- ============================== -->
    <dbquery id="mnu">
      <![CDATA[select pno, gid, des, typ from pa where gid='$gp' and active>0 order by pno]]>
    </dbquery>
    <dbgroup dataset="mnu">
      <setvar name="row" value="0"/>
      <setvar name="col" value="0"/>
      <block name="sidebar.aa"/>
      <group>
        <setvar name="ic" value="''"/>
        <setvar name="app" value="''"/>
        <switch exp="mnu.typ">
          <case value="b">
            <setvar name="app" value="'book'"/>
          </case>
          <case value="n">
            <setvar name="app" value="'note'"/>
          </case>
          <case value="p">
            <setvar name="app" value="'page'"/>
          </case>
          <case value="s">
            <setvar name="app" value="'shop'"/>
          </case>
          <default>
            <setvar name="app" value="'grid'"/>
          </default>
        </switch>
        <if cnd="gp='0000'">
          <block name="sidebar-item"/>
          <else/>
          <block name="sidebar-item"/>
        </if>
      </group>
      <block name="sidebar.zz"/>
    </dbgroup>
  </card>

  <card id="content" device="sub">
    <dbquery id="mnu">
      <![CDATA[select pno, gid, des, typ from pa where gid='$gp' and active>0 order by pno]]>
    </dbquery>
    <dbgroup dataset="mnu">
      <setvar name="row" value="0"/>
      <setvar name="col" value="0"/>
      <block name="grid.aa"/>

        <setvar name="col" value="0"/>
        <block name="category" category="category" />
        <block name="grid-list.aa"/>
        <group>
          <setvar name="ic" value="''"/>
          <setvar name="app" value="''"/>
          <switch exp="mnu.typ">
            <case value="b">
              <setvar name="app" value="'book'"/>
            </case>
            <case value="n">
              <setvar name="app" value="'note'"/>
            </case>
            <case value="p">
              <setvar name="app" value="'page'"/>
            </case>
            <case value="s">
              <setvar name="app" value="'shop'"/>
            </case>
            <default>
              <setvar name="app" value="'grid'"/>
            </default>
          </switch>
          <if cnd="gp='0000'">
            <block name="grid-item"/>
            <else/>
            <block name="grid-item"/>
          </if>
        </group>
        <block name="grid-list.zz"/>

      <block name="grid.zz"/>
    </dbgroup>
  </card>
</wml>