<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS only: images in this folder are sent by IIS as static files, without
  going through WapServ.dll, so they need their own CORS header for a
  Flutter Web app (another origin) to draw them with Image.network.
  Kept in this folder only: .wml responses already get the header from
  WapServ.dll, and a second copy would make the browser reject it.
  WapServer (http://localhost:8080/) ignores this file.
-->
<configuration>
  <system.webServer>
    <httpProtocol>
      <customHeaders>
        <add name="Access-Control-Allow-Origin" value="*" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
