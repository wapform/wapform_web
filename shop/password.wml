<?xml version="1.0"?>
<wml>
  <card id="P" title="WapForm Stationery" device="wapform.html">
    <setvar name="category" value="'Message'" />
    <dbquery id="sys">select * from sys</dbquery>
    <block name="wapform.aa" />
    <include name="header" />
    <block name="content.aa" />
    <if cnd="DEFINE(request.password1)">
      <if cnd="(password1&lt;&gt;'') and (password2&lt;&gt;'')">
        <if cnd="password1&lt;&gt;password2">
          <block name="alert" title="'Error'" message="'The confirmation password does not match.'" />
          <else />
          <dbquery id="xy">
            <![CDATA[select * from cu where password='$id']]>
          </dbquery>
          <if cnd="xy.count&gt;0">
            <dbquery>
              <![CDATA[update cu set password='$(MD5(password1))' where password='$id']]>
            </dbquery>
            <block name="alert" title="'Message'" message="'Your password has been reset.'" />
            <else />
            <block name="alert" title="'Error'" message="'The reset request has expired. Please request a new one.'" />
          </if>
        </if>
        <else />
        <block name="alert" title="'Error'" message="'Password is empty.'" />
      </if>
      <else />
      <block name="password" />
    </if>
    <block name="content.zz" />
    <include name="footer" />
    <include name="asider"/>
    <block name="wapform.zz" />
  </card>
  <card id="slider" device="sub">
  </card>
  <card id="breadcrumb" device="sub">
    <block name="breadcrumb" one="'Forgot Password'" />
  </card>
</wml>