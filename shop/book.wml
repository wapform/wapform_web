<?xml version="1.0"?>
<wml>
  <card id="P" device="wapform.html">
    <setvar name="i" value="0" />
    <setvar name="gp" value="'note'" />
    <setvar name="gp" value="request.gp" cnd="define(request.gp)" />
    <setvar name="pg" value="'note'" />
    <setvar name="pg" value="request.pg" cnd="DEFINE(request.pg)" />
    <setvar name="sr" value="'az'" />
    <setvar name="sr" value="request.sort" cnd="define(request.sort)" />
    <setvar name="id" value="''" />
    <setvar name="i" value="0" />
    <setvar name="s" value="'Product Info'" />
    <setvar name="b" value="0" />
    <setvar name="gtitle" value="mid(gp,1,2)+'00'" />
    <setvar name="breadcrumb" value="'User Manual'" />
    <if cnd="DEFINE(session.usr)">
      <setvar name="B" value="1" cnd="session.usr='admin'" />
    </if>
    <dbquery id="sys">select * from sys</dbquery>
    <dbquery id="grp">
      <![CDATA[select pno, gid, des from pa where pno='$gp' and active>0 order by pno]]>
    </dbquery>
    <setvar name="s" value="grp.des" />
    <setvar name="s" value="grp.gid" />
    <if cnd="gp='0000'">
      <setvar name="category" value="'All Categories'" />
      <else />
      <setvar name="category" value="grp.des" />
    </if>
    <block name="wapform.aa" />
    <include name="header" />
    <block name="onbook" />
    <include name="footer" />
    <include name="asider"/>
    <block name="wapform.zz" />
  </card>
  <card id="slider" device="sub">
    <block name="slider" />
  </card>
  <card id="breadcrumb" device="sub">
    <block name="breadcrumb" one="category" />
  </card>
  <card id="sidebar" device="sub">
    <block name="nestbar.aa" />
    <dbquery id="mnu">
      <![CDATA[select pno, gid, des, typ from pa where gid='$gp' and active>0 order by pno]]>
    </dbquery>
    <setvar name="id" value="mnu.pno" />
    <while cnd="not(mnu.eof)">
      <block name="nestbar-list.aa" />
      <dbquery id="itm">
        <![CDATA[select pno, gid, des, typ from pa where gid='$mnu.pno' and active>0 order by pno]]>
      </dbquery>
      <while cnd="not(itm.eof)">
        <block name="nestbar-item" />
        <invoke instance="itm" method="next" />
      </while>
      <block name="nestbar-list.zz" />
      <invoke instance="mnu" method="next" />
    </while>
    <block name="nestbar.zz" />
    <!--
        <dbquery id="mnu">
            <![CDATA[select pno, gid, des, typ from pa where gid='$gp' and active>0 order by pno]]>
        </dbquery>
        <setvar name="id" value="mnu.pno" />
        <dbgroup dataset="mnu">
            <setvar name="row" value="0" />
            <setvar name="col" value="0" />
            <block name="nestbar.aa" />
            <group change="mnu.gid">
                <block name="nestbar-list.aa" />
                <group>
                    <setvar name="ic" value="''" />
                    <setvar name="app" value="'note'" />
                    <block name="nestbar-item" />
                </group>
                <block name="nestbar-list.zz" />
            </group>
            <block name="nestbar.zz" />
        </dbgroup>
-->
  </card>
  <card id="content" device="sub">
    <![CDATA[
        <div id="xyz"></div>
        <script>
        loadDoc('book-js.wml?pg=$id');
        </script>
]]>
  </card>
</wml>