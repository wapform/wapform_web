<?xml version="1.0"?>
<wml>
	<card id="P" title="Product Master" width="1200">

		<!-- Intentional example: WapForm embeds native target-language source code directly in WML.
		     <platform> + <![CDATA[ ]]> lets a .wml carry original Flutter (Dart) code today, and the same
		     mechanism is meant for original COBOL code (<platform name="cobol">, WapForm COBOL, in development):
		     the CDATA is copied as-is into the generated program, so a feature without a WML tag on that
		     platform is written once in its own language and the rest of the card stays declarative.
		     Here WapForm for Flutter has no equivalent of <img> (nor of <open>/<webcopy>):
		       Windows: uses <open>, <webcopy>, <img> and <setprop prop="img"> as usual;
		       Flutter: Dart code inside <platform name="flutter">, copied into app002.dart by the generator
		                (part="import" goes to the import section). -->
		<platform name="flutter" part="import"><![CDATA[
import 'package:file_picker/file_picker.dart';
import 'package:http/http.dart' as http;
		]]></platform>

		<function id="A0">
			<platform name="windows">
				<setvar name="I" value="0"/>
				<setvar name="S" value="''"/>
				<open filename="S" result="I"/>
				<if cnd="I=1">
					<log message="$S"/>
					<!-- unique: save under a timestamp name (ASCII only, never overwrites another product's image) -->
					<webcopy protocol="httpupload" unique="yes"
						host="http://localhost:8080/shop/upload.wml"
						url="$S"
						result="R"
						errmsg="E"/>
					<if cnd="E=''">
						<setvar name="paicon" value="R"/>
						<!-- save the new image name right away -->
						<invoke instance="pa" method="post"/>
						<log message="$paicon"/>
						<else>
							<!-- keep the record's current image on failure -->
							<log message="Upload failed: $E"/>
							<alert message="Upload failed: $E"/>
						</else>
					</if>
					<go href="@SHOWIMG"/>
				</if>
			</platform>
			<platform name="flutter"><![CDATA[
final f = await FilePicker.pickFile(type: FileType.image);
if (f == null) return;
final bytes = await f.readAsBytes();
// timestamp name, like <webcopy unique>: ASCII only, never overwrites another image
final name = '${DateTime.now().millisecondsSinceEpoch}.${(f.extension ?? 'jpg').toLowerCase()}';
// Same page as the Windows <webcopy>: shop/upload.wml on WapServer
// (http://localhost:8080/shop/; under IIS use http://localhost/shop/).
// <upload> takes the file name from Content-Disposition and the type from
// Content-Type, so both must be sent.
const types = {'jpg': 'image/jpeg', 'jpeg': 'image/jpeg', 'png': 'image/png',
    'gif': 'image/gif', 'bmp': 'image/bmp'};
final ext = (f.extension ?? 'jpg').toLowerCase();
try {
  final res = await http.put(
      Uri.parse('http://localhost:8080/shop/upload.wml'),
      headers: {
        'Content-Type': types[ext] ?? 'application/octet-stream',
        'Content-Disposition': 'attachment; filename="$name"',
      },
      body: bytes);
  // upload.wml answers with its page; the saved name is in "Saved <b>...</b>"
  final saved = RegExp(r'Saved <b>([^<]+)</b>').firstMatch(res.body)?.group(1);
  if (res.statusCode == 200 && saved != null) {
    // write the new image name and save it right away
    setvar("pa.icon", "'$saved'");
    await _saveAsync(_pa);
  } else {
    await _alert("Upload failed: HTTP ${res.statusCode}");
  }
} catch (e) {
  await _alert("Upload failed: $e");
}
			]]></platform>
		</function>

		<function id="B0">
			<platform name="windows">
				<setvar name="paicon" value="''"/>
				<invoke instance="pa" method="post"/>
				<go href="@SHOWIMG"/>
			</platform>
			<platform name="flutter"><![CDATA[
setvar("pa.icon", "''");
await _saveAsync(_pa);
			]]></platform>
		</function>

		<!-- show the product image, or the default image when icon is empty (Windows) -->
		<function id="SHOWIMG">
			<platform name="windows">
				<setprop name="g0" prop="img" value="IF(paicon='', 'http://localhost:8080/shop/300x300.jpg', 'http://localhost:8080/shop/upload/'+paicon)"/>
			</platform>
		</function>

		<dbquery id="pa">
			<![CDATA[select * from pa order by pno]]>
			<field fieldname="Pno" displaylabel="Item No" />
			<field fieldname="Qno" displaylabel="SKU">
				<onevent type="onchange">
					<dbquery id="xy">
						<![CDATA[select * from pa where qno='$pa.qno']]>
					</dbquery>
					<alert message="Duplicate SKU !!!" cnd="xy.count&gt;0" />
				</onevent>
			</field>
			<field fieldname="Barcode" displaylabel="Barcode" />
			<field fieldname="vno" displaylabel="Brand Code" />
			<dbtable tablename="ve" keyfields="vno" lookupkeyfields="vno">
				<field fieldname="vshort" displaylabel="Brand Short Name" />
			</dbtable>
			<field fieldname="Des" displaylabel="Item Name / Spec" />
			<field fieldname="Unit" displaylabel="Unit" />
			<field fieldname="pricea" displaylabel="Price A" />
			<field fieldname="priceb" displaylabel="Price B" />
			<field fieldname="pricec" displaylabel="Price C" />
			<field fieldname="price1" displaylabel="Price 1" />
			<field fieldname="price2" displaylabel="Price 2" />
			<field fieldname="price3" displaylabel="Price 3" />
			<field fieldname="active" displaylabel="Listed" />
			<field fieldname="UDate" displaylabel="Updated Date" />
			<field fieldname="newa" displaylabel="Price 4" />
			<field fieldname="new1" displaylabel="Price 5" />
			<field fieldname="topic" displaylabel="Image" />
			<field fieldname="mnu" displaylabel="Menu" />
			<field fieldname="typ" displaylabel="Type" />
			<field fieldname="ord" displaylabel="Sort Order" />
			<field fieldname="qty" displaylabel="Minimum" />
			<field fieldname="icon" displaylabel="Icon" />
			<onevent type="onnewrecord">
				<setvar name="paactive" value="1" />
			</onevent>
			<onevent type="afterscroll">
				<!-- Flutter: the generated afterScroll already rebuilds the page, so the image follows the record -->
				<platform name="windows"><go href="@SHOWIMG"/></platform>
			</onevent>
		</dbquery>
		<pagecontrol name="pagecontrol" activepageindex="0">
			<tabsheet caption="Product Search">
				<datasource dataset="pa">
					<dbfilter result="R">
						<item field="pno" size="16" />
						<item field="des" size="16" />
						<onevent type="onfilter">
							<dbquery id="pa"><![CDATA[select * from pa where $R order by pno]]></dbquery>
						</onevent>
					</dbfilter>
					<p align="center">
						<navigator />
					</p>
					<dbgrid height="350">
						<item field="Pno" size="14" />
						<item field="Qno" size="14" />
						<item field="vno" size="14" lookup="ve;vno;vname" />
						<item field="vshort" size="20" />
						<item field="UDate" size="16" type="date" />
						<item field="Des" size="40" />
						<item field="Unit" size="6" />
						<item field="active" size="10" type="checkbox" display="m;n" value="1;0" />
						<item field="pricea" size="10" />
						<item field="priceb" size="10" />
						<item field="pricec" size="10" />
						<item field="price1" size="10" />
						<item field="price2" size="10" />
						<item field="price3" size="10" />
						<item field="Barcode" size="30" />
						<item field="newa" size="10" />
						<item field="new1" size="10" />
						<item field="icon" size="30" />
						<item field="mnu" size="10" type="checkbox" display="m;n" value="m;n" />
						<item field="typ" size="10" />
						<item field="ord" size="10" />
						<item field="qty" size="10" />
						<onevent type="ondblclick">
							<setprop name="pagecontrol" prop="activePageIndex" value="1"/>
						</onevent>
					</dbgrid>
				</datasource>
			</tabsheet>
			<tabsheet caption="Product Details">
				<datasource dataset="pa">
					<p align="center">
						<navigator />
					</p>
					<br />
					<br />
					<br />
					<table columns="5" align="LLLLC">
						<tr>
							<td>
								<fieldset>
									Item No:<input field="Pno" _size="30" /><br />
									SKU:<input field="Qno" _size="30" /><br />
									Updated Date:<input field="UDate" _size="10" /><br />
									Item Name / Spec:<input field="Des" _size="30" /><br />
									Icon:<input field="icon" size="40" /><br />
									Barcode:<input field="Barcode" size="40" /><br />
									Unit:<input field="Unit" size="2" /><br />
									Listed:<input field="active" size="2" _type="checkbox" value="1;0" /><br />
									Menu:<input field="mnu" size="2" />&#160;m.Menu n.Product<br />
									Type:<input field="typ" size="2" />&#160;s.Item p.Page n.Note<br />
									Sort Order:<input field="ord" size="6" /><br />
									Minimum:<input field="qty" size="6" /><br />
								</fieldset>
							</td>
							<td width="15"></td>
							<td>
								<fieldset>
									Brand Code:<input field="vno" size="10" lookup="sql;vv;select distinct vno, vshort from ve" /><br />
									Brand Short Name:<input field="vshort" size="10" /><br />
									Standard Cost:<input field="pricea" size="10" /><br />
									Latest Cost:<input field="priceb" size="10" /><br />
									Latest Market Price:<input field="pricec" size="10" /><br />
									Price 1<input field="price1" size="10" /><br />
									Price 2<input field="price2" size="10" /><br />
									Price 3<input field="price3" size="10" /><br />
									Price 4<input field="newa" size="10" /><br />
									Price 5<input field="new1" size="10" /><br />
								</fieldset>
							</td>
							<td width="15"></td>
							<td>
								<!-- Image area: intentionally uses <img>, which WapForm for Flutter does not have, to show the embedding approach.
								     Windows uses <img id="g0">, whose image @SHOWIMG swaps via <setprop>;
								     Flutter embeds a Widget (Image.network) through CDATA; the page rebuilds on scroll, so the image follows the record. -->
								<platform name="windows">Image | <a href="@A0">Open</a> | <a href="@B0">Clear</a><br/><img id="g0" width="300" height="300"/></platform>
								<platform name="flutter"><![CDATA[
Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
  Row(mainAxisSize: MainAxisSize.min, children: [
    const Text("Image  "),
    TButton(caption: "Open", onClick: () async { await _a0(); if (mounted) setState(() {}); }),
    const SizedBox(width: 6),
    TButton(caption: "Clear", onClick: () async { await _b0(); if (mounted) setState(() {}); }),
  ]),
  const SizedBox(height: 6),
  Image.network(
    _str(_pa, "icon").isEmpty
        ? "http://localhost:8080/shop/300x300.jpg"
        : "http://localhost:8080/shop/upload/${_str(_pa, "icon")}",
    width: 300, height: 300, fit: BoxFit.contain,
    errorBuilder: (_, __, ___) => const SizedBox(width: 300, height: 300,
        child: Center(child: Text("No image")))),
]),
								]]></platform>
							</td>
						</tr>
					</table>
					<!--
-->
					<platform name="windows"><go href="@SHOWIMG"/></platform>
				</datasource>
			</tabsheet>
		</pagecontrol>
		<do type="prev" label="Close">
			<prev />
		</do>
	</card>
</wml>